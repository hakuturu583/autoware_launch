<launch>
  <!-- planning module -->

  <!-- mission planner -->
  <arg name="mission_planner_param_path"/>
  <!-- parking -->
  <arg name="freespace_planner_param_path"/>
  <!-- planning validator -->
  <arg name="planning_validator_param_path"/>
  <arg name="planning_validator_latency_checker_param_path"/>
  <arg name="planning_validator_trajectory_checker_param_path"/>
  <arg name="planning_validator_intersection_collision_checker_param_path"/>
  <arg name="planning_validator_rear_collision_checker_param_path"/>
  <arg name="planning_validator_boundary_departure_checker_param_path"/>
  <!-- Auto mode setting-->
  <arg name="enable_all_modules_auto_mode"/>
  <arg name="is_simulation"/>
  <arg name="launch_remaining_distance_time_calculator" default="false"/>
  <!-- Input topic parameters -->
  <arg name="input_objects_topic_name"/>
  <arg name="input_pointcloud_topic_name"/>
  <!-- Artifacts -->
  <arg name="data_path"/>
  <!-- Container the ResWorld planner node is composed into (resworld only) -->
  <arg name="pointcloud_container_name" default="/pointcloud_container"/>
  <!-- ResWorld only: keep its detection, sideline its trajectory (see resworld.launch.xml). -->
  <arg name="resworld_detach_trajectory" default="false" description="true: another trajectory model drives; the ResWorld node keeps running for detection only"/>

  <group>
    <push-ros-namespace namespace="planning"/>
    <!-- manual lane change handler module -->
    <!-- Not under resworld: the trajectory comes from the model, so a manual lane change
         request has no consumer here. It is also unsafe to start in a log replay, where the
         map and the route are both latched and the handler can take the route first: its
         route_callback dereferences a lanelet map it has not built yet and segfaults in
         RouteHandler::getLaneletsFromId(), taking the whole planning stack down with it. -->
    <group unless="$(eval &quot;'$(var planning_setting)'=='resworld'&quot;)">
      <push-ros-namespace namespace="mission_planning"/>
      <include file="$(find-pkg-share autoware_manual_lane_change_handler)/launch/manual_lane_change_handler.launch.xml">
        <arg name="mission_planner_param_path" value="$(var mission_planner_param_path)"/>
      </include>
    </group>
    <!-- mission planning module -->
    <group>
      <push-ros-namespace namespace="mission_planning"/>
      <include file="$(find-pkg-share tier4_planning_launch)/launch/mission_planning/mission_planning.launch.xml">
        <arg name="mission_planner_param_path" value="$(var mission_planner_param_path)"/>
      </include>
    </group>

    <!-- scenario planning module -->
    <group if="$(eval &quot;'$(var planning_setting)'=='rule_based'&quot;)">
      <push-ros-namespace namespace="scenario_planning"/>
      <include file="$(find-pkg-share tier4_planning_launch)/launch/scenario_planning/scenario_planning.launch.xml">
        <arg name="enable_all_modules_auto_mode" value="$(var enable_all_modules_auto_mode)"/>
        <arg name="is_simulation" value="$(var is_simulation)"/>
        <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
        <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
      </include>
    </group>

    <!-- LatentDrive: modifier/optimizer only; planner runs on another ECU -->
    <group if="$(eval &quot;'$(var planning_setting)'=='latentdrive'&quot;)">
      <include file="$(find-pkg-share tier4_planning_launch)/launch/learning_based_planning/latentdrive.launch.xml">
        <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
        <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
        <arg name="trajectory_modifier_param_path" value="$(var trajectory_modifier_param_path)"/>
        <arg name="trajectory_optimizer_param_path" value="$(var trajectory_optimizer_param_path)"/>
        <arg name="jerk_filtered_smoother_param_path" value="$(var jerk_filtered_smoother_param_path)"/>
        <arg name="velocity_smoother_param_path" value="$(var velocity_smoother_param_path)"/>
        <arg name="common_smoother_param_path" value="$(var common_smoother_param_path)"/>
        <arg name="elastic_band_param_path" value="$(var elastic_band_param_path)"/>
        <arg name="trajectory_point_fixer_param_path" value="$(var trajectory_point_fixer_param_path)"/>
        <arg name="trajectory_extender_param_path" value="$(var trajectory_extender_param_path)"/>
        <arg name="trajectory_spline_smoother_param_path" value="$(var trajectory_spline_smoother_param_path)"/>
        <arg name="trajectory_qp_smoother_param_path" value="$(var trajectory_qp_smoother_param_path)"/>
        <arg name="trajectory_velocity_optimizer_param_path" value="$(var trajectory_velocity_optimizer_param_path)"/>
        <arg name="trajectory_kinematic_feasibility_enforcer_param_path" value="$(var trajectory_kinematic_feasibility_enforcer_param_path)"/>
        <arg name="trajectory_mpt_optimizer_param_path" value="$(var trajectory_mpt_optimizer_param_path)"/>
        <arg name="trajectory_temporal_mpt_optimizer_param_path" value="$(var trajectory_temporal_mpt_optimizer_param_path)"/>
        <arg name="trajectory_time_sequence_raw_optimizer_param_path" value="$(var trajectory_time_sequence_raw_optimizer_param_path)"/>
        <arg name="hazard_lights_selector_param_path" value="$(var hazard_lights_selector_param_path)"/>
      </include>
    </group>

    <!-- diffusion planner module -->
    <group if="$(eval &quot;'$(var planning_setting)'=='diffusion_planner'&quot;)">
      <include file="$(find-pkg-share tier4_planning_launch)/launch/learning_based_planning/diffusion_planner.launch.xml">
        <arg name="is_simulation" value="$(var is_simulation)"/>
        <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
        <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
        <arg name="data_path" value="$(var data_path)"/>
        <arg name="diffusion_planner_param_path" value="$(var diffusion_planner_param_path)"/>
        <arg name="trajectory_modifier_param_path" value="$(var trajectory_modifier_param_path)"/>
        <arg name="trajectory_optimizer_param_path" value="$(var trajectory_optimizer_param_path)"/>
        <arg name="jerk_filtered_smoother_param_path" value="$(var jerk_filtered_smoother_param_path)"/>
        <arg name="velocity_smoother_param_path" value="$(var velocity_smoother_param_path)"/>
        <arg name="common_smoother_param_path" value="$(var common_smoother_param_path)"/>
        <arg name="elastic_band_param_path" value="$(var elastic_band_param_path)"/>
        <arg name="trajectory_point_fixer_param_path" value="$(var trajectory_point_fixer_param_path)"/>
        <arg name="trajectory_extender_param_path" value="$(var trajectory_extender_param_path)"/>
        <arg name="trajectory_spline_smoother_param_path" value="$(var trajectory_spline_smoother_param_path)"/>
        <arg name="trajectory_qp_smoother_param_path" value="$(var trajectory_qp_smoother_param_path)"/>
        <arg name="trajectory_velocity_optimizer_param_path" value="$(var trajectory_velocity_optimizer_param_path)"/>
        <arg name="trajectory_kinematic_feasibility_enforcer_param_path" value="$(var trajectory_kinematic_feasibility_enforcer_param_path)"/>
        <arg name="trajectory_mpt_optimizer_param_path" value="$(var trajectory_mpt_optimizer_param_path)"/>
        <arg name="trajectory_temporal_mpt_optimizer_param_path" value="$(var trajectory_temporal_mpt_optimizer_param_path)"/>
        <arg name="trajectory_time_sequence_raw_optimizer_param_path" value="$(var trajectory_time_sequence_raw_optimizer_param_path)"/>
        <arg name="hazard_lights_selector_param_path" value="$(var hazard_lights_selector_param_path)"/>
      </include>
    </group>

    <!-- end-to-end planner module -->
    <group if="$(eval &quot;'$(var planning_setting)'=='e2e_planner'&quot;)">
      <include file="$(find-pkg-share tier4_planning_launch)/launch/learning_based_planning/e2e_planner.launch.xml">
        <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
        <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
        <arg name="data_path" value="$(var data_path)"/>
        <arg name="e2e_planner_param_path" value="$(var e2e_planner_param_path)"/>
        <arg name="trajectory_modifier_param_path" value="$(var trajectory_modifier_param_path)"/>
        <arg name="trajectory_optimizer_param_path" value="$(var trajectory_optimizer_param_path)"/>
        <arg name="jerk_filtered_smoother_param_path" value="$(var jerk_filtered_smoother_param_path)"/>
        <arg name="velocity_smoother_param_path" value="$(var velocity_smoother_param_path)"/>
        <arg name="common_smoother_param_path" value="$(var common_smoother_param_path)"/>
        <arg name="elastic_band_param_path" value="$(var elastic_band_param_path)"/>
        <arg name="trajectory_point_fixer_param_path" value="$(var trajectory_point_fixer_param_path)"/>
        <arg name="trajectory_extender_param_path" value="$(var trajectory_extender_param_path)"/>
        <arg name="trajectory_spline_smoother_param_path" value="$(var trajectory_spline_smoother_param_path)"/>
        <arg name="trajectory_qp_smoother_param_path" value="$(var trajectory_qp_smoother_param_path)"/>
        <arg name="trajectory_velocity_optimizer_param_path" value="$(var trajectory_velocity_optimizer_param_path)"/>
        <arg name="trajectory_kinematic_feasibility_enforcer_param_path" value="$(var trajectory_kinematic_feasibility_enforcer_param_path)"/>
        <arg name="trajectory_mpt_optimizer_param_path" value="$(var trajectory_mpt_optimizer_param_path)"/>
        <arg name="trajectory_temporal_mpt_optimizer_param_path" value="$(var trajectory_temporal_mpt_optimizer_param_path)"/>
        <arg name="trajectory_time_sequence_raw_optimizer_param_path" value="$(var trajectory_time_sequence_raw_optimizer_param_path)"/>
        <arg name="hazard_lights_selector_param_path" value="$(var hazard_lights_selector_param_path)"/>
      </include>
    </group>

    <!-- ResWorld module -->
    <group if="$(eval &quot;'$(var planning_setting)'=='resworld'&quot;)">
      <include file="$(find-pkg-share tier4_planning_launch)/launch/learning_based_planning/resworld.launch.xml">
        <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
        <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
        <arg name="data_path" value="$(var data_path)"/>
        <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
        <arg name="resworld_detach_trajectory" value="$(var resworld_detach_trajectory)"/>
        <arg name="e2e_planner_param_path" value="$(var e2e_planner_param_path)"/>
        <arg name="trajectory_modifier_param_path" value="$(var trajectory_modifier_param_path)"/>
        <arg name="trajectory_optimizer_param_path" value="$(var trajectory_optimizer_param_path)"/>
        <arg name="jerk_filtered_smoother_param_path" value="$(var jerk_filtered_smoother_param_path)"/>
        <arg name="velocity_smoother_param_path" value="$(var velocity_smoother_param_path)"/>
        <arg name="common_smoother_param_path" value="$(var common_smoother_param_path)"/>
        <arg name="elastic_band_param_path" value="$(var elastic_band_param_path)"/>
        <arg name="trajectory_point_fixer_param_path" value="$(var trajectory_point_fixer_param_path)"/>
        <arg name="trajectory_extender_param_path" value="$(var trajectory_extender_param_path)"/>
        <arg name="trajectory_spline_smoother_param_path" value="$(var trajectory_spline_smoother_param_path)"/>
        <arg name="trajectory_qp_smoother_param_path" value="$(var trajectory_qp_smoother_param_path)"/>
        <arg name="trajectory_velocity_optimizer_param_path" value="$(var trajectory_velocity_optimizer_param_path)"/>
        <arg name="trajectory_kinematic_feasibility_enforcer_param_path" value="$(var trajectory_kinematic_feasibility_enforcer_param_path)"/>
        <arg name="trajectory_mpt_optimizer_param_path" value="$(var trajectory_mpt_optimizer_param_path)"/>
        <arg name="trajectory_temporal_mpt_optimizer_param_path" value="$(var trajectory_temporal_mpt_optimizer_param_path)"/>
        <arg name="trajectory_time_sequence_raw_optimizer_param_path" value="$(var trajectory_time_sequence_raw_optimizer_param_path)"/>
        <arg name="hazard_lights_selector_param_path" value="$(var hazard_lights_selector_param_path)"/>
      </include>
    </group>

    <!-- planning validator -->
    <group>
      <let name="validator_input_trajectory" value="/planning/trajectory_generator/trajectory" if="$(eval &quot;'$(var planning_setting)'=='diffusion_planner'&quot;)"/>
      <let name="validator_input_trajectory" value="/planning/trajectory_generator/trajectory" if="$(eval &quot;'$(var planning_setting)'=='latentdrive'&quot;)"/>
      <let name="validator_input_trajectory" value="/planning/trajectory_generator/trajectory" if="$(eval &quot;'$(var planning_setting)'=='e2e_planner'&quot;)"/>
      <let name="validator_input_trajectory" value="/planning/trajectory_generator/trajectory" if="$(eval &quot;'$(var planning_setting)'=='resworld'&quot;)"/>
      <let name="validator_input_trajectory" value="/planning/scenario_planning/velocity_smoother/trajectory" if="$(eval &quot;'$(var planning_setting)'=='rule_based'&quot;)"/>
      <include file="$(find-pkg-share autoware_planning_validator)/launch/planning_validator.launch.xml">
        <arg name="container_type" value="component_container_mt"/>
        <arg name="input_trajectory_topic_name" value="$(var validator_input_trajectory)"/>
        <arg name="output_trajectory" value="/planning/trajectory"/>
        <arg name="input_objects_topic_name" value="$(var input_objects_topic_name)"/>
        <arg name="input_pointcloud_topic_name" value="$(var input_pointcloud_topic_name)"/>
        <arg name="planning_validator_param_path" value="$(var planning_validator_param_path)"/>
        <arg name="planning_validator_latency_checker_param_path" value="$(var planning_validator_latency_checker_param_path)"/>
        <arg name="planning_validator_trajectory_checker_param_path" value="$(var planning_validator_trajectory_checker_param_path)"/>
        <arg name="planning_validator_intersection_collision_checker_param_path" value="$(var planning_validator_intersection_collision_checker_param_path)"/>
        <arg name="planning_validator_rear_collision_checker_param_path" value="$(var planning_validator_rear_collision_checker_param_path)"/>
        <arg name="planning_validator_boundary_departure_checker_param_path" value="$(var planning_validator_boundary_departure_checker_param_path)"/>
      </include>
    </group>

    <!-- planning evaluator -->
    <group>
      <let
        name="evaluator_input_reference_trajectory"
        value="/planning/trajectory_generator/neural_network_based_planner/diffusion_planner_node/output/trajectory"
        if="$(eval &quot;'$(var planning_setting)'=='diffusion_planner'&quot;)"
      />
      <let name="evaluator_input_reference_trajectory" value="/planning/generator/e2e_planner/trajectory" if="$(eval &quot;'$(var planning_setting)'=='e2e_planner'&quot;)"/>
      <let
        name="evaluator_input_reference_trajectory"
        value="/planning/scenario_planning/lane_driving/motion_planning/path_optimizer/trajectory"
        if="$(eval &quot;'$(var planning_setting)'=='rule_based'&quot;)"
      />

      <let
        name="evaluator_input_objects"
        value="/planning/trajectory_generator/neural_network_based_planner/diffusion_planner_node/output/predicted_objects"
        if="$(eval &quot;'$(var planning_setting)'=='diffusion_planner'&quot;)"
      />
      <!-- The generic end-to-end chain publishes no predicted objects, so the
           evaluator keeps perception's and scores against the model's own
           pre-optimizer trajectory. -->
      <let name="evaluator_input_objects" value="/perception/object_recognition/objects" if="$(eval &quot;'$(var planning_setting)'=='e2e_planner'&quot;)"/>
      <let name="evaluator_input_objects" value="/perception/object_recognition/objects" if="$(eval &quot;'$(var planning_setting)'=='rule_based'&quot;)"/>

      <!-- ResWorld predicts no objects: its graph has no neighbour tensor, so there
           is nothing to attach predicted paths to and the output does not exist.
           Perception's, built from this planner's own detection head, is what
           there is to score against. The reference is the model's own
           pre-optimizer trajectory. -->
      <let
        name="evaluator_input_reference_trajectory"
        value="/planning/generator/resworld/trajectory"
        if="$(eval &quot;'$(var planning_setting)'=='resworld' and '$(var resworld_detach_trajectory)'!='true'&quot;)"
      />
      <!-- Detached, the model still publishes its reference trajectory, just on the sidelined topic. -->
      <let
        name="evaluator_input_reference_trajectory"
        value="/planning/generator/resworld/detached/trajectory"
        if="$(eval &quot;'$(var planning_setting)'=='resworld' and '$(var resworld_detach_trajectory)'=='true'&quot;)"
      />
      <let name="evaluator_input_objects" value="/perception/object_recognition/objects" if="$(eval &quot;'$(var planning_setting)'=='resworld'&quot;)"/>

      <!-- Remote LatentDrive uses the same reference topic family as local diffusion_planner. -->
      <let
        name="evaluator_input_reference_trajectory"
        value="/planning/trajectory_generator/neural_network_based_planner/diffusion_planner_node/output/trajectory"
        if="$(eval &quot;'$(var planning_setting)'=='latentdrive'&quot;)"
      />
      <let name="evaluator_input_objects" value="/perception/object_recognition/objects" if="$(eval &quot;'$(var planning_setting)'=='latentdrive'&quot;)"/>

      <include file="$(find-pkg-share autoware_planning_evaluator)/launch/planning_evaluator.launch.xml">
        <arg name="input/reference_trajectory" value="$(var evaluator_input_reference_trajectory)"/>
        <arg name="input/objects" value="$(var evaluator_input_objects)"/>
      </include>
    </group>

    <!-- mission remaining distance and time calculator -->
    <group if="$(var launch_remaining_distance_time_calculator)">
      <include file="$(find-pkg-share autoware_remaining_distance_time_calculator)/launch/remaining_distance_time_calculator.launch.xml"/>
    </group>
  </group>
</launch>
