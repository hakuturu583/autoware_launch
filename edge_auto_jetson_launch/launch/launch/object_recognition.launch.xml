<launch>
  <arg name="camera_id" default=""/>
  <arg name="roi_id" default=""/>
  <arg name="dla_core_id" default=""/>
  <arg name="build_engine_only" default="false"/>

  <arg name="model_path" default="/opt/autoware/mlmodels/yolox/yolox-sPlus-T4-960x960-debris.onnx"/>
  <arg name="label_path" default="/opt/autoware/mlmodels/yolox/label.txt"/>
  <arg name="yolox_param_path" default="$(find-pkg-share edge_auto_jetson_launch)/config/tensorrt_yolox.param.yaml"/>
  <arg name="yolox_precision" default="int8" description="Operation precision to be used on inference. Valid value is one of: [fp32, fp16, int8]."/>

  <let name="input/camera" value="/sensing/camera/camera$(var camera_id)"/>
  <let name="input/image" value="$(var input/camera)/image_raw"/>
  <let name="input/image_rect" value="$(var input/camera)/image_rect_color"/>
  <let name="detection/output/objects" value="/perception/object_recognition/detection/yolox/rois$(var roi_id)"/>
  <let name="tracking/output/objects" value="/perception/object_recognition/detection/rois$(var roi_id)"/>
  <arg name="input/image/is_raw" default="false"/>

  <arg name="enable_bytetrack_visualizer" default="false"/>

  <arg name="container_name" default="object_recognition_container$(var camera_id)"/>
  <arg name="use_intra_process" default="true"/>
  <arg name="use_multithread" default="true"/>
  <let name="container_type" value="component_container_mt" if="$(var use_multithread)"/>
  <let name="container_type" value="component_container" unless="$(var use_multithread)"/>

  <group if="$(var build_engine_only)">
    <node pkg="autoware_tensorrt_yolox" exec="autoware_tensorrt_yolox_node_exe" name="tensorrt_yolox">
      <param from="$(var yolox_param_path)" allow_substs="true"/>
      <param name="precision" value="$(var yolox_precision)"/>
      <param name="dla_core_id" value="$(var dla_core_id)"/>
      <param name="build_only" value="$(var build_engine_only)"/>
    </node>
  </group>

  <group unless="$(var build_engine_only)">
    <!-- object recognition container -->
    <node_container pkg="rclcpp_components" exec="$(var container_type)" name="$(var container_name)" namespace="">
      <!-- yolox -->
      <composable_node pkg="autoware_tensorrt_yolox" plugin="autoware::tensorrt_yolox::TrtYoloXNode" name="tensorrt_yolox$(var camera_id)" namespace="/perception/object_recognition/detection">
        <remap from="~/in/image" to="$(var input/image)"/>
        <remap from="~/out/objects" to="$(var detection/output/objects)"/>
        <remap from="~/out/image" to="$(var detection/output/objects)/debug/image"/>
        <remap from="~/out/image/compressed" to="$(var detection/output/objects)/debug/image/compressed"/>
        <remap from="~/out/image/compressedDepth" to="$(var detection/output/objects)/debug/image/compressedDepth"/>
        <remap from="~/out/image/theora" to="$(var detection/output/objects)/debug/image/theora"/>
        <remap from="~/out/mask" to="/perception/object_recognition/detection/mask$(var camera_id)"/>
        <param from="$(var yolox_param_path)" allow_substs="true"/>
        <param name="model_path" value="$(var model_path)"/>
        <param name="label_path" value="$(var label_path)"/>
        <param name="precision" value="$(var yolox_precision)"/>
        <param name="dla_core_id" value="$(var dla_core_id)"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>

      <!-- bytetrack -->
      <composable_node pkg="autoware_bytetrack" plugin="autoware::bytetrack::ByteTrackNode" name="bytetrack$(var camera_id)" namespace="/perception/object_recognition/detection">
        <remap from="~/in/rect" to="$(var detection/output/objects)"/>
        <remap from="~/out/objects" to="$(var tracking/output/objects)"/>
        <remap from="~/out/objects/debug/uuid" to="$(var tracking/output/objects)/debug/uuid"/>
        <param name="track_buffer_length" value="30"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>
    </node_container>

    <!-- Execute bytetrack visualizer as a separated node -->
    <node pkg="autoware_bytetrack" exec="autoware_bytetrack_visualizer_node_exe" name="bytetrack_visualizer$(var camera_id)" if="$(var enable_bytetrack_visualizer)">
      <remap from="~/in/image" to="$(var input/image)"/>
      <remap from="~/in/rect" to="$(var tracking/output/objects)"/>
      <remap from="~/in/uuid" to="$(var tracking/output/objects)/debug/uuid"/>
      <remap from="~/out/image" to="$(var tracking/output/objects)/debug/image"/>
      <remap from="~/out/image/compressed" to="$(var tracking/output/objects)/debug/image/compressed"/>
      <remap from="~/out/image/compressedDepth" to="$(var tracking/output/objects)/debug/image/compressedDepth"/>
      <remap from="~/out/image/theora" to="$(var tracking/output/objects)/debug/image/theora"/>
      <param name="use_raw" value="$(var input/image/is_raw)"/>
    </node>
  </group>
</launch>
